# Skool authentication (passed to the Apify actor)
SKOOL_EMAIL=
SKOOL_PASSWORD=

# Skool communities (full URL or slug)
FREE_COMMUNITY_URL=
PAID_COMMUNITY_URL=

# Google Sheets target
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_MEMBERS_SHEET=Members
GOOGLE_SHEETS_DAILY_METRICS_SHEET=DailyMetrics
GOOGLE_SHEETS_MEMBERS_FILTER=converted

# Google OAuth credentials (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_TOKEN_PATH=./data/google_oauth_token.json

# Apify configuration
APIFY_API_TOKEN=
APIFY_ACTOR_ID=cristiantala/skool-all-in-one-api

# Operational
TIMEZONE=UTC
LOG_LEVEL=INFO
